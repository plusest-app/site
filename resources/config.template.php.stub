<?php

/**
 * ============================================================================
 *  Plusest Site — налаштування
 * ============================================================================
 *
 *  Цей файл згенерований установником. Його можна і треба правити вручну —
 *  це звичайний масив PHP. Наступний запуск установника його не перезапише.
 *
 *  Повна інструкція з налаштування вебсервера — у файлі docs/nginx.md
 *
 *  Шляхи у секції 'paths' можна писати відносно каталогу цього файлу.
 * ============================================================================
 */

return [

    // ------------------------------------------------------------------------
    //  Часовий пояс
    //
    //  У цьому поясі скрипт синхронізації рахує «денні години» розкладу
    //  (секція sync нижче), у ньому пишеться час у базу й у лог.
    //
    //  Задати його треба обовʼязково. Інакше PHP бере пояс із php.ini, а він
    //  у cron і у вебсервері буває різний і зазвичай це UTC — і тоді вікно
    //  «з 8 до 21» насправді припадає на зовсім інші години, а ранкові
    //  звернення до CRM потрапляють у нічний, рідкісний інтервал.
    //
    //  Порожній рядок означає «не чіпати пояс із php.ini».
    //  Список назв: https://www.php.net/manual/en/timezones.php
    // ------------------------------------------------------------------------
    'timezone' => {{timezone}},

    // ------------------------------------------------------------------------
    //  База даних MySQL
    // ------------------------------------------------------------------------
    'db' => [
        'host'     => {{dbHost}},
        'port'     => {{dbPort}},
        'name'     => {{dbName}},
        'user'     => {{dbUser}},
        'password' => {{dbPassword}},
        'charset'  => {{dbCharset}},

        // Якщо MySQL слухає unix-сокет, а не порт — вкажіть шлях до нього,
        // тоді host і port будуть проігноровані.
        'socket'   => {{dbSocket}},

        // Префікс назв таблиць. Потрібен, якщо ви ставите заготовку в базу,
        // де вже є ваші власні таблиці. Приклад: 'plusest_' дасть таблиці
        // plusest_objects, plusest_staff, plusest_syncState.
        'prefix'   => {{dbPrefix}},

        // Додаткові опції PDO. Перекривають наші значення за замовчуванням.
        'options'  => [],
    ],

    // ------------------------------------------------------------------------
    //  Фід обʼєктів з CRM
    // ------------------------------------------------------------------------
    'feed' => [
        // Перейдіть в інтеграцію компанії (https://plusest.app/cabinet/company/integrations/) в Plusest
        // та активуйте інтеграцію "JSON-feed для сайту компанії". Скопіюйте посилання на JSON-feed та вставте в це поле.
        // Посилання містить секретний код — нікому його не показуйте.
        'url'        => {{feedUrl}},

        // Скільки секунд чекати відповідь. Фід великого агентства може
        // готуватися довго, тому значення навмисно велике.
        'timeout'    => {{feedTimeout}},

        // Скільки разів повторити запит, якщо мережа підвела.
        'retries'    => {{feedRetries}},

        // Пауза між повторними спробами, секунди.
        'retryDelay' => {{feedRetryDelay}},

        // Перевіряти SSL-сертифікат. Вимикайте лише якщо ваш сервер має
        // застарілий набір кореневих сертифікатів і запит падає з помилкою SSL.
        'verifySsl'  => {{feedVerifySsl}},
    ],

    // ------------------------------------------------------------------------
    //  Шляхи у файловій системі
    //
    //  Відносні шляхи розкриваються від каталогу цього файлу.
    // ------------------------------------------------------------------------
    'paths' => [
        // Службовий каталог: завантажені моделі, лог синхронізації, lock-файл.
        // НЕ повинен бути доступний з вебу.
        'data'      => {{pathsData}},

        // Каталог, куди завантажуються фотографії обʼєктів і співробітників.
        // Повинен бути доступний з вебу — саме звідси браузер бере картинки.
        //
        // Кожна публікація отримує власний підкаталог, названий її
        // ідентифікатором, а в ньому — по файлу на кожен розмір із секції
        // 'photos' нижче:
        //
        //   photos/objects/{objectPublicationId}/{idФото}-{назваРозміру}.jpg
        //
        // Фотографія співробітника — виняток: розмірів у неї немає, вона
        // зберігається одним файлом такою, як прийшла з CRM:
        //
        //   photos/staff/{agentId}/{photo}.jpg
        //
        // Коли публікація зникає з CRM і налаштування вимагають видалення,
        // її каталог видаляється цілком.
        'photos'    => {{pathsPhotos}},

        // Каталог із шаблонами. Правьте їх під дизайн свого сайту.
        'templates' => {{pathsTemplates}},

        // Файл схеми бази даних.
        'schema'    => {{pathsSchema}},
    ],

    // ------------------------------------------------------------------------
    //  Публічні URL
    // ------------------------------------------------------------------------
    'urls' => [
        // Шлях, за яким база нерухомості доступна на вашому сайті.
        // Саме його ви вказали в nginx: location /base/ { ... }
        // Обовʼязково з двома слешами — на початку і в кінці.
        'base'   => {{urlsBase}},

        // Шлях, за яким браузер отримує завантажені фотографії.
        // Зазвичай це 'base' + 'photos/'. Якщо ви віддаєте картинки з CDN
        // або з іншого домену — вкажіть повний URL із https://
        'photos' => {{urlsPhotos}},
    ],

    // ------------------------------------------------------------------------
    //  Мови
    //
    //  CRM віддає тексти й назви двома мовами. Залиште в 'available' обидві,
    //  щоб у відвідувачів був перемикач мов, або лише одну — тоді перемикач
    //  не показується, а зайва мова просто не використовується.
    // ------------------------------------------------------------------------
    'lang' => [
        'available' => {{langAvailable}},
        'default'   => {{langDefault}},
    ],

    // ------------------------------------------------------------------------
    //  Валюти
    //
    //  Ціна приходить з CRM одразу в трьох валютах, тому перемикання валюти
    //  на сайті нічого не перераховує — просто показує інший стовпець.
    //
    //  Валюту вибирає сам відвідувач, і його вибір діє на всі публікації
    //  незалежно від типу операції. Поки він не вибрав нічого, показуємо
    //  першу валюту зі списку.
    // ------------------------------------------------------------------------
    'currency' => [
        // Які валюти показувати відвідувачу. Перша у списку — та, яку бачить
        // відвідувач, що ще не торкався перемикача.
        'available' => {{currencyAvailable}},
    ],

    // ------------------------------------------------------------------------
    //  Сторінки бази обʼєктів
    //
    //  Налаштування самого розділу сайту: скільки обʼєктів на сторінці,
    //  як їх сортувати за замовчуванням і що робити з реалізованими.
    // ------------------------------------------------------------------------
    'site' => [
        // Заголовок розділу. Показується у <title> і в заголовку сторінки
        // списку обʼєктів.
        'titleUk' => {{siteTitleUk}},
        'titleRu' => {{siteTitleRu}},

        // Скільки обʼєктів показувати на одній сторінці списку.
        'perPage' => {{sitePerPage}},

        // Сортування за замовчуванням. Доступні значення:
        //
        //   'new'        — спочатку нові публікації;
        //   'old'        — спочатку давні;
        //   'priceUp'    — від дешевих до дорогих;
        //   'priceDown'  — від дорогих до дешевих;
        //   'areaUp'     — від меншої площі до більшої;
        //   'areaDown'   — від більшої до меншої.
        'sortDefault' => {{siteSortDefault}},

        // Показувати реалізовані обʼєкти (status = sold) у загальному списку.
        //
        // true  — показуємо, але завжди після актуальних і з позначкою
        //         «реалізовано»: відвідувач бачить, що агентство справді
        //         продає обʼєкти;
        // false — реалізовані доступні лише за прямим посиланням.
        //
        // За яких умов обʼєкт стає реалізованим, вирішує налаштування
        // sync.missingMode нижче.
        'showSold' => {{siteShowSold}},

        // Значення відстані до метро (метри), які пропонуються у фільтрі.
        'metroDistances' => {{siteMetroDistances}},
    ],

    // ------------------------------------------------------------------------
    //  Фотографії
    // ------------------------------------------------------------------------
    'photos' => [
        // Бібліотека обробки зображень: 'gd' або 'imagick'.
        // GD є майже на кожному хостингу; Imagick дає кращу якість масштабування.
        'driver' => {{photosDriver}},

        // Якість JPEG на виході, 0-100. 85 — розумний компроміс.
        'quality' => {{photosQuality}},

        // Розміри, у які масштабується кожна фотографія обʼєкта.
        // Фотографій співробітників це не стосується: вони зберігаються
        // такими, як приходять з CRM.
        //
        //  Ключ масиву — назва розміру. Саме за нею шаблони звертаються до
        //  файлу, тому назви можна змінювати, але тоді треба виправити й шаблони.
        //  Додати четвертий розмір можна просто дописавши сюди ще один блок.
        //
        //  aspectRatio — зберігати пропорції оригіналу;
        //  upsize      — забороняти збільшення фото, менших за заданий розмір;
        //  width       — обмеження по ширині в пікселях (null — не обмежувати);
        //  height      — обмеження по висоті в пікселях (null — не обмежувати).
        //
        //  Масштабування виконується від найбільшого розміру до найменшого:
        //  результат більшого розміру клонується і зменшується далі. Тому
        //  порядок у масиві не важливий — розміри сортуються автоматично.
        'sizes' => [
            // Велика фотографія для перегляду в галереї.
            'large' => [
                'aspectRatio' => true,
                'upsize'      => true,
                'width'       => {{photosLargeWidth}},
                'height'      => {{photosLargeHeight}},
            ],

            // Середня — для карток у загальному списку обʼєктів.
            'medium' => [
                'aspectRatio' => true,
                'width'       => {{photosMediumWidth}},
                'height'      => {{photosMediumHeight}},
            ],

            // Мініатюра — для стрічки фото та компактних списків.
            'preview' => [
                'aspectRatio' => false,
                'width'       => {{photosPreviewWidth}},
                'height'      => {{photosPreviewHeight}},
            ],
        ],
    ],

    // ------------------------------------------------------------------------
    //  Синхронізація
    // ------------------------------------------------------------------------
    'sync' => [
        // Що робити з публікацією, яка зникла з фіда.
        //
        //   'sold'   — позначити реалізованою: обʼєкт залишається на сайті,
        //              але з відповідною позначкою. Рекомендований варіант;
        //   'hidden' — прибрати з пошуку, але зберегти в базі та за прямим
        //              посиланням;
        //   'delete' — видалити рядок разом із завантаженими фотографіями.
        //
        // Окремо від цього правила: якщо співробітник зник зі складу
        // агентства (його звільнили), всі його публікації видаляються
        // безповоротно. Обʼєкт із контактами звільненого агента показувати
        // на сайті не можна.
        'missingMode' => {{syncMissingMode}},

        // --- Як часто звертатись до CRM -------------------------------------
        //
        //  Завдання cron ставиться часто — раз на 15 хвилин, — а вирішує,
        //  запитувати фід цього разу чи ні, сам скрипт. Прогони, що на розклад
        //  не потрапили, не марні: вони дозавантажують фотографії з хмарного
        //  сховища, на яке обмежень немає.
        //
        //  Уночі та у вихідні обʼєкти майже не публікують, тому інтервал там
        //  більший. Значення в секундах; 0 вимикає розклад і фід запитується
        //  кожним прогоном cron.
        //
        //  Окреме правило, якого немає в цих налаштуваннях: якщо CRM
        //  відмовила у видачі даних (невірне посилання, не оплачений доступ,
        //  забагато запитів), наступна спроба буде лише через 8 годин. Немає
        //  сенсу довбати сервер, поки причину не усунуто.
        //
        //  Ключ --force обходить розклад разово.

        // Пн-пт у денні години. 7200 — дві години.
        'intervalDay' => {{syncIntervalDay}},

        // Ніч і вихідні. 21600 — шість годин.
        'intervalNight' => {{syncIntervalNight}},

        // Межі «денних годин»: з якої години і до якої діє intervalDay.
        'dayFrom' => {{syncDayFrom}},
        'dayTo'   => {{syncDayTo}},

        // Скільки фотографій завантажувати за один прогон. 0 — без обмеження.
        // Обмеження корисне при першому запуску на слабкому хостингу: cron
        // добере решту наступними прогонами.
        'photoLimit' => {{syncPhotoLimit}},

        // Скільки секунд чекати завантаження однієї фотографії.
        'photoTimeout' => {{syncPhotoTimeout}},

        // Записувати хід синхронізації у файл data/sync.log
        'log' => {{syncLog}},

        // Скільки рядків логу зберігати. Старіші відкидаються.
        'logLines' => {{syncLogLines}},
    ],

    // ------------------------------------------------------------------------
    //  Запуск синхронізації через браузер
    //
    //  Потрібен лише тим, у кого немає доступу до cron через SSH і завдання
    //  налаштовуються через панель хостингу. Якщо ви запускаєте bin/sync.php
    //  зі звичайного cron — залиште 'token' порожнім, і веб-запуск буде
    //  повністю вимкнений.
    // ------------------------------------------------------------------------
    'cron' => [
        // Секретний токен. Без нього public/cron.php відповідає 404.
        // Нікому не показуйте це значення і не додавайте його в репозиторій.
        'token' => {{cronToken}},

        // Мінімальний інтервал між веб-запусками, секунди. Захист від того,
        // щоб хтось не запустив синхронізацію сотні разів підряд.
        'minInterval' => {{cronMinInterval}},
    ],

    // ------------------------------------------------------------------------
    //  Налагодження
    // ------------------------------------------------------------------------
    'debug' => [
        // Показувати повний текст помилок на сторінках сайту.
        // На робочому сайті обовʼязково false.
        'enabled' => {{debugEnabled}},

        // Дописувати в кінець сторінки сводку про те, з чого склався час
        // відповіді: тривалість кожного етапу формування HTML і кожного
        // запиту до бази.
        //
        // Сводка йде після закритого </html> у вигляді HTML-комментаря —
        // відвідувач її не бачить, вона видна лише у початковому коді
        // сторінки (Ctrl+U у браузері).
        //
        // Увімкніть, коли сторінки почали відкриватись повільно: сводка
        // одразу покаже, де саме час — у базі, у шаблонах чи в підключенні
        // до MySQL. На робочому сайті вимикайте: у сводці видно текст
        // SQL-запитів.
        'summary' => {{debugSummary}},
    ],
];

/*
 * ============================================================================
 *  Завдання cron
 * ============================================================================
 *
 *  Заготовка нічого не забирає з CRM сама — це робить скрипт синхронізації,
 *  який треба запускати за розкладом:
 *
 *      # Синхронізація — кожні 15 хвилин
 *      3,18,33,48 * * * * /usr/bin/php {{cronScriptPath}} --quiet >> /dev/null 2>&1
 *
 *  Кожні 15 хвилин — і при цьому CRM турбуємо лише за розкладом із секції
 *  'sync' вище: у будні дні раз на дві години, уночі та у вихідні раз на
 *  шість. Часті прогони потрібні не для фіда, а для фотографій: саме вони
 *  дозавантажуються тоді, коли до CRM звертатись ще рано.
 *
 *  Час запуску навмисно не рівний (3, 18, 33, 48 хвилини, а не 0, 15, 30,
 *  45): так запити всіх сайтів не приходять у CRM одночасно.
 *
 *  Ключ --quiet прибирає звичайні повідомлення, залишаючи лише попередження
 *  та помилки: тоді панель хостингу надішле вам листа тільки коли щось пішло
 *  не так, а не після кожного прогону.
 *
 *  Якщо доступу до cron через SSH немає, а панель хостингу вміє лише
 *  «викликати URL за розкладом» — заповніть секцію 'cron' вище і вкажіть
 *  у панелі таку адресу:
 *
 *      {{cronWebUrl}}
 *
 *  Повна інструкція з налаштування вебсервера — docs/nginx.md
 * ============================================================================
 */
